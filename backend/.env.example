# ─── Server ───────────────────────────────────────────────
PORT=3001

# ─── CORS: set to your deployed frontend URL in production ─
FRONTEND_URL=http://localhost:5173

# ─── Admin token: use this to view messages via GET /api/contacts?token=... ─
ADMIN_TOKEN=change_this_to_a_secret_string

# ─── Email notifications (optional) ───────────────────────
# Use a Gmail account + App Password (not your real password)
# Generate App Password: myaccount.google.com → Security → App Passwords
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here
